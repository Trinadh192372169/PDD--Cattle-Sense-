# ==========================================
# CattleSense Backend Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL with SQLite fallback)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cattlesense

# Example for Supabase / Neon / Cloud PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/cattlesense?sslmode=require

# Groq LLM API Key (Optional: for live AI breed summaries)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Twilio SMS Configuration (Optional: for mobile OTP)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
